---
import HeroFrame from "./HeroFrame.astro"
import HeroText from "./HeroText.astro"
import HeroBackground from "./HeroBackground.astro"
---

<section
    class="hero relative h-screen w-full overflow-hidden bg-black"
    data-parallax-hero>
    <!-- Borde Hero -->
    <HeroFrame />
    <!-- Frases mágicas -->
    <HeroText />
    <!-- Parallax -->
    <HeroBackground />

    <!-- BOTÓN SCROLL -->
    <a
        href="#movie-info"
        class="scroll-button"
        aria-label="Ir a la información de la película">

        <span class="scroll-arrow">↓</span>
        <span class="scroll-text">DESCUBRIR</span>
    </a>
</section>

<style>
    .hero {
        position: absolute;
    }

    /* Boton Descubrir */
    .scroll-button {
        position: absolute;
        left: 50%;
        bottom: clamp(35px, 5vh, 70px);
        transform: translateX(-50%);
        z-index: 11;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
        color: white;
        text-decoration: none;
        cursor: pointer;
        transition:
        transform 0.3s ease,
        opacity 0.3s ease;
    }
    .scroll-button:hover {
        transform: translateX(-50%) translateY(-5px);
    }
    .scroll-arrow {
        font-size: 2rem;
        line-height: 1;
        animation: scrollBounce 1.8s ease-in-out infinite;
    }
    .scroll-text {
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.25em;
        white-space: nowrap;
    }
    @keyframes scrollBounce {
        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(7px);
        }
    }
</style>

<script>
    import { initHeroParallax } from "../../lib/animations/parallax";

    initHeroParallax();
</script>
