<div class="border-frame">
    <!-- Botón menú -->
    <button class="corner-icon top-left" data-nav="menu">
        <img src="/icons/menu.svg" alt="Menu" class="icon-svg" />
        <span class="tooltip tooltip-up">Menu</span>
    </button>

    <!-- Botón Facebook -->
    <button class="corner-icon top-right" data-nav="facebook">
        <img src="/icons/facebook.svg" alt="Facebook" class="icon-svg" />
        <span class="tooltip tooltip-up">Facebook</span>
    </button>

    <!-- Botón Instagram -->
    <button class="corner-icon top-right2" data-nav="instagram">
        <img src="/icons/instagram.svg" alt="Instagram" class="icon-svg" />
        <span class="tooltip tooltip-up">Instagram</span>
    </button>

    <!-- Botón Movie Info -->
    <button class="corner-icon bottom-left" data-nav="#movie-info">
        <img src="/icons/boleto.svg" alt="Movie Info" class="icon-svg" />
        <span class="tooltip tooltip-bottom">Boletos</span>
    </button>

    <!-- Botón Trailer -->
    <button class="corner-icon bottom-right" data-nav="#trailer">
        <img src="/icons/video.svg" alt="Trailer" class="icon-svg" />
        <span class="tooltip tooltip-bottom">Trailer</span>
    </button>

    <!-- Menú compacto -->
    <nav id="corner-menu" class="corner-menu">
        <ul>
            <li><a href="#hero">Hero</a></li>
            <li><a href="#trailer">Trailer</a></li>
            <li><a href="#synopsis">Synopsis</a></li>
            <li><a href="#cast">Cast</a></li>
            <li><a href="#crew">Crew</a></li>
        </ul>
    </nav>


    <!-- Líneas -->
    <div class="frame-line top"></div>
    <div class="frame-line bottom"></div>
    <div class="frame-line left"></div>
    <div class="frame-line right"></div>
</div>

<style>
    .border-frame {
        position: absolute;
        inset: clamp(20px, 3vw, 40px);
        pointer-events: none;
        z-index: 10;
    }
    /* Horizontal lines */
    .frame-line.top,
    .frame-line.bottom {
        position: absolute;
        left: 10%;
        right: 10%;
        height: 2px;
        background: #05a85c;
    }
    .frame-line.top { top: 0; }
    .frame-line.bottom { bottom: 0; }

    /* Vertical lines */
    .frame-line.left,
    .frame-line.right {
        position: absolute;
        top: 10%;
        bottom: 10%;
        width: 2px;
        background: #05a85c;
    }
    .frame-line.left { left: 0; }
    .frame-line.right { right: 0; }

    /* Corners Buttons */
    .corner-icon {
        position: absolute;
        background: none;
        border: none;
        cursor: pointer;
        pointer-events: auto;
        transition: transform 0.3s ease;
    }
    .corner-icon:hover {
        transform: scale(1.2) rotate(10deg);
    }
    .icon-svg {
        width: 2rem;
        height: 2rem;
        filter: invert(47%) sepia(92%) saturate(356%) hue-rotate(90deg);
    }
    /* Mensaje label de los botones */
    .tooltip {
        position: absolute;
        transform: translateX(-50%);
        background: #05a85c;
        color: white;
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease, transform 0.3s ease;
    }

    /* Tooltips que aparecen debajo del botón (superiores) */
    .tooltip-bottom {
        bottom: 2rem; /* aparece arriba */
        left: 50%;
    }

    /* Tooltips que aparecen arriba del botón (inferiores) */
    .tooltip-up {
        top: 2rem;   /* aparece debajo */
        left: 50%;
    }

    /* Corner Buttons Positions */
    .corner-icon.top-left { top: -0.8rem; left: 0; }
    .corner-icon.top-right { top: -0.8rem; right: 0; }
    .corner-icon.top-right2 { top: -0.8rem; right: 3rem; }
    .corner-icon.bottom-left { bottom: -0.8rem; left: 0; }
    .corner-icon.bottom-right { bottom: -0.8rem; right: 0; }
    .icon-svg {
        width: 2rem;
        height: 2rem;
        filter: invert(47%) sepia(92%) saturate(356%) hue-rotate(90deg) brightness(95%) contrast(90%);
        transition: filter 0.3s ease;
    }
    .corner-icon:hover .icon-svg {
        filter: invert(62%) sepia(92%) saturate(356%) hue-rotate(90deg) brightness(120%) contrast(100%);
    }
    /* Menu Desplegable */
    .corner-menu {
        position: absolute;
        top: 2.5rem; /* debajo del botón */
        left: 0;
        background: rgba(0,0,0,0.85);
        border: 1px solid #05a85c;
        border-radius: 6px;
        padding: 0.5rem 1rem;
        opacity: 0;
        pointer-events: none;
        transform: translateY(-10px);
        transition: opacity 0.3s ease, transform 0.3s ease;
        z-index: 10;
    }

    .corner-menu ul {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .corner-menu li {
        margin: 1rem 2rem;
    }

    .corner-menu a {
        color: #05a85c;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .corner-menu a:hover {
        color: #22c55e;
    }

    /* Estado activo */
    .corner-menu.active {
        opacity: 1;
        pointer-events: auto;
        transform: translateY(0);
    }
</style>


<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { ScrollToPlugin } from "gsap/ScrollToPlugin";

    gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

    // Hover tooltips
    document.querySelectorAll(".corner-icon").forEach(btn => {
        const tooltip = btn.querySelector(".tooltip");
        btn.addEventListener("mouseenter", () => {
            gsap.to(tooltip, { opacity: 1, y: -5, duration: 0.3 });
        });
        btn.addEventListener("mouseleave", () => {
            gsap.to(tooltip, { opacity: 0, y: 0, duration: 0.3 });
        });
    });

    // Navegación con scroll
    document.querySelectorAll(".corner-icon[data-nav]").forEach(btn => {
        const target = btn.getAttribute("data-nav");
        if (target == null ) {return}
        if (target.startsWith("#")) {
            btn.addEventListener("click", () => {
            gsap.to(window, { scrollTo: target, duration: 1, ease: "power2.inOut" });
            });
        }
    });
    // ScrollSpy
    const sections = document.querySelectorAll("section");
        sections.forEach(sec => {
        ScrollTrigger.create({
            trigger: sec,
            start: "top center",
            end: "bottom center",
            onEnter: () => highlightNav(sec.id),
            onEnterBack: () => highlightNav(sec.id),
        });
    });

    function highlightNav(id:any) {
        document.querySelectorAll(".corner-icon").forEach(btn => {
            btn.classList.remove("active");
            if (btn.getAttribute("data-nav") === `#${id}`) {
            btn.classList.add("active");
            }
        });
    }


    /* Menu gsap  */
    const menuBtn = document.querySelector(".corner-icon[data-nav='menu']");
    const cornerMenu = document.getElementById("corner-menu");

    if (menuBtn && cornerMenu) {
        menuBtn.addEventListener("click", () => {
            if (cornerMenu.classList.contains("active")) {
            gsap.to(cornerMenu, { opacity: 0, y: -10, duration: 0.3, onComplete: () => cornerMenu.classList.remove("active") });
            } else {
            cornerMenu.classList.add("active");
            gsap.fromTo(cornerMenu, { opacity: 0, y: -10 }, { opacity: 1, y: 0, duration: 0.3 });
            }
        });
    }

    // Navegación suave
    document.querySelectorAll("#corner-menu a").forEach(link => {
        link.addEventListener("click", e => {
            e.preventDefault();
            const target = link.getAttribute("href");
            if (target == null || cornerMenu == null){return}
            gsap.to(window, { scrollTo: target, duration: 1, ease: "power2.inOut" });
            gsap.to(cornerMenu, { opacity: 0, y: -10, duration: 0.3, onComplete: () => cornerMenu.classList.remove("active") });
        });
    });
</script>