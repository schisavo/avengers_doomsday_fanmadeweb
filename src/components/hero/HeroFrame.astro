<div class="border-frame">

    <!-- Botón Facebook -->
    <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="corner-icon top-right" data-nav="facebook">
        <img src="/icons/facebook.svg" alt="Facebook" class="icon-svg" />
        <span class="tooltip tooltip-up">Facebook</span>
    </a>

    <!-- Botón Instagram -->
    <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="corner-icon top-right2" data-nav="instagram">
        <img src="/icons/instagram.svg" alt="Instagram" class="icon-svg" />
        <span class="tooltip tooltip-up">Instagram</span>
    </a>

    <!-- Botón Movie Info -->
    <a class="corner-icon bottom-left" data-nav="#movie-info">
        <img src="/icons/boleto.svg" alt="Movie Info" class="icon-svg" />
        <span class="tooltip tooltip-bottom">Tickets</span>
    </a>

    <!-- Botón Trailer -->
    <a href="https://www.youtube.com/" target="_blank" rel="noopener noreferrer" class="corner-icon bottom-right" data-nav="#trailer">
        <img src="/icons/video.svg" alt="Trailer" class="icon-svg" />
        <span class="tooltip tooltip-bottom">Trailer</span>
    </a>

    <!-- Líneas -->
    <div class="frame-line top"></div>
    <div class="frame-line bottom"></div>
    <div class="frame-line left"></div>
    <div class="frame-line right"></div>
</div>

<style>
    .border-frame {
        position: absolute;
        inset: clamp(20px, 3vw, 40px);
        pointer-events: none;
        z-index: 4;
    }
    /* Horizontal lines */
    .frame-line.top,
    .frame-line.bottom {
        position: absolute;
        left: 10%;
        right: 10%;
        height: 2px;
        background: #05a85c;
    }
    .frame-line.top { top: 0; }
    .frame-line.bottom { bottom: 0; }

    /* Vertical lines */
    .frame-line.left,
    .frame-line.right {
        position: absolute;
        top: 10%;
        bottom: 10%;
        width: 2px;
        background: #05a85c;
    }
    .frame-line.left { left: 0; }
    .frame-line.right { right: 0; }

    /* Corners Buttons */
    .corner-icon {
        position: absolute;
        background: none;
        border: none;
        cursor: pointer;
        pointer-events: auto;
        transition: transform 0.3s ease;
    }
    .corner-icon:hover {
        transform: scale(1.2) rotate(10deg);
    }
    .icon-svg {
        width: 2rem;
        height: 2rem;
        filter: invert(47%) sepia(92%) saturate(356%) hue-rotate(90deg);
    }
    /* Mensaje label de los botones */
    .tooltip {
        position: absolute;
        transform: translateX(-50%);
        background: #05a85c;
        color: white;
        font-size: 0.75rem;
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease, transform 0.3s ease;
    }

    /* Tooltips que aparecen debajo del botón (superiores) */
    .tooltip-bottom {
        bottom: 2rem; /* aparece arriba */
        left: 50%;
    }

    /* Tooltips que aparecen arriba del botón (inferiores) */
    .tooltip-up {
        top: 2rem;   /* aparece debajo */
        left: 50%;
    }

    /* Corner Buttons Positions */
    .corner-icon.top-right { top: -0.8rem; right: 0; }
    .corner-icon.top-right2 { top: -0.8rem; right: 3rem; }
    .corner-icon.bottom-left { bottom: -0.8rem; left: 0; }
    .corner-icon.bottom-right { bottom: -0.8rem; right: 0; }
    .icon-svg {
        width: 2rem;
        height: 2rem;
        filter: invert(47%) sepia(92%) saturate(356%) hue-rotate(90deg) brightness(95%) contrast(90%);
        transition: filter 0.3s ease;
    }
    .corner-icon:hover .icon-svg {
        filter: invert(62%) sepia(92%) saturate(356%) hue-rotate(90deg) brightness(120%) contrast(100%);
    }

    /* Media Queries */
    @media (max-width: 992px) {
        .top-right, .top-right2 {
            margin-top: 1.5rem;
        }
        .bottom-left, .bottom-right {
            margin-bottom: 1.5rem;
        }
    }
</style>


<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { ScrollToPlugin } from "gsap/ScrollToPlugin";

    gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

    // Hover tooltips
    document.querySelectorAll(".corner-icon").forEach(btn => {
        const tooltip = btn.querySelector(".tooltip");
        btn.addEventListener("mouseenter", () => {
            gsap.to(tooltip, { opacity: 1, y: -5, duration: 0.3 });
        });
        btn.addEventListener("mouseleave", () => {
            gsap.to(tooltip, { opacity: 0, y: 0, duration: 0.3 });
        });
    });
</script>