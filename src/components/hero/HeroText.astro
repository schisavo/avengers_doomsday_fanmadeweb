<!-- Magic Words -->
<div 
  class="hero-text absolute inset-x-4 top-[12%] z-4 flex flex-col items-center px-4 text-center">
  <p id="frase"
    class="text-base sm:text-lg md:text-2xl lg:text-2xl font-semibold tracking-wide text-white max-w-[90%] sm:max-w-[80%] md:max-w-[60%] leading-tight">
  </p>
</div>

<style>
  @media (max-width: 600px) {
    .hero-text {
        margin-top: 5rem;
        top: 50%; /* un poco más arriba en móvil */
        inset: 5%; /* margen lateral más estrecho */
    }
    #frase {
      font-size: 0.9rem; /* tamaño compacto en móvil */
      line-height: 1.3;  /* mejor legibilidad */
    }
  }
</style>


<script>
    import { animarFrases } from "../../lib/animations/heroTextAnimation";

    const frases = [
        {
        equipo: "Avengers",
        texto: "If the universe they swore to protect no longer exists, against whom will they exact their revenge?",
        color: "#df0e0e" // rojo
        },
        {
        equipo: "X-Men",
        texto: "They changed the future, but what future do they have left to protect?",
        color: "#f1c40d" // amarillo
        },
        {
        equipo: "Fantastic Four",
        texto: "They discovered other worlds, but what will they do when none of them is their own?",
        color: "#0e60e6" // azul
        }
    ];
    animarFrases(frases);
</script>