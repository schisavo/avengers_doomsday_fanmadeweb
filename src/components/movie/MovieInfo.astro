---
import Trailer from "./Trailer.astro";
import Synopsis from "./Synopsis.astro";
import Carousel from "../carousel/Carousel.astro";
import CastCard from "../cast/CastCard.astro";
import CrewCard from "../crew/crewCard.astro";
import { cast } from "../../data/cast";
import { crew } from "../../data/crew";
import Gallery from "../gallery/Gallery.astro";
import Footer from "../footer/footer.astro";
---

<section
    id="movie-info"
    class="min-h-screen bg-black px-6"
>
    <div class="mx-auto max-w-6xl">
        <!-- Trailer -->
        <section id="trailer" class="scroll-mt-24">
            <Trailer />
        </section>

        <!-- Synopsis -->
        <section id="synopsis" class="scroll-mt-24">
            <Synopsis />
        </section>

        <!-- Cast -->
        <section id="cast" class="scroll-mt-24">
            <Carousel
                title="Cast"
                description="Meet the cast of the movie."
                items={cast}
                cardComponent={CastCard}
                showFilters={true}
                filterBy="team"
            />
        </section>

        <!-- Crew -->
        <section id="crew" class="scroll-mt-24">
            <Carousel
                title="Crew"
                description="Meet the people behind Avengers: Doomsday"
                items={crew}
                cardComponent={CrewCard}
                showFilters={true}
                filterBy="team"
            />
        </section>

        <!-- Gallery -->
        <section id="gallery" class="scroll-mt-24">
            <Gallery />
        </section>

        <!-- Footer -->
        <section id="footer" class="scroll-mt-24">
            <Footer />
        </section>

        
    </div>
</section>