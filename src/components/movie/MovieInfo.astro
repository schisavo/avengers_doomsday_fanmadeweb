---
import Trailer from "./Trailer.astro";
import Synopsis from "./Synopsis.astro";
import Carousel from "../carousel/Carousel.astro";
import CastCard from "../cast/CastCard.astro";
import CrewCard from "../crew/crewCard.astro";
import { cast } from "../../data/cast";
import { crew } from "../../data/crew";
import Gallery from "../gallery/Gallery.astro";
---

<section
    id="movie-info"
    class="min-h-screen bg-black px-6 py-24"
>
    <div class="mx-auto max-w-6xl">
        <!-- Movie Trailer Section -->
        <Trailer />
        <!-- Movie Sypnosis Section -->
        <Synopsis />
        <!-- Movie Cast Section -->
        <Carousel
            title="Cast"
            description="Conoce al reparto de la película"
            items={cast}
            cardComponent={CastCard}
            showFilters={true}
            filterBy="team"
        />
        <!-- Crew Team Movie Section -->
        <Carousel
            title="Crew"
            description="Conoce a las personas detrás de Avengers: Doomsday"
            items={crew}
            cardComponent={CrewCard}
            showFilters={true}
            filterBy="team"
        />
        <!-- Movie Gallery -->
        <Gallery />
        
    </div>
</section>