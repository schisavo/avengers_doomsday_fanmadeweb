<section class="trailer-section">
    <!-- TÍTULO -->
    <div class="trailer-heading">
        <span class="trailer-eyebrow">AVENGERS: DOOMSDAY</span>
        <h2>TRAILER</h2>
    </div>

    <!-- VIDEO -->
    <div class="trailer-wrapper">
        <video
            class="trailer-video"
            controls
            preload="metadata"
            playsinline>
            <source
                src="/videos/doomsday-trailer.mp4"
                type="video/mp4"
            />
            Tu navegador no soporta la reproducción de video.
        </video>
    </div>
</section>


<style>
    /* =========================================
    SECTION
    ========================================= */
    .trailer-section {
        width: 100%;
        margin-bottom: 6rem;
    }

    /* =========================================
    TITLE
    ========================================= */
    .trailer-heading {
        text-align: center;
        margin-bottom: 2rem;
    }
    .trailer-eyebrow {
        display: block;
        margin-bottom: 0.75rem;
        font-size: 0.65rem;
        font-weight: 600;
        letter-spacing: 0.35em;
        color: #05a85c;
    }
    .trailer-heading h2 {
        margin: 0;
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 800;
        letter-spacing: 0.12em;
        line-height: 1;
        color: white;
    }

    /* =========================================
    VIDEO CONTAINER
    ========================================= */
    .trailer-wrapper {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: #090909;
        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 6px;
        box-shadow:
            0 20px 60px rgba(0, 0, 0, 0.45);
    }

    /* =========================================
    VIDEO
    ========================================= */
    .trailer-video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        background: #000;
    }

    /* =========================================
    TABLET
    ========================================= */
    @media (max-width: 900px) {
        .trailer-section {
            margin-bottom: 4rem;
        }
    }

    /* =========================================
    MOBILE
    ========================================= */
    @media (max-width: 600px) {
        .trailer-heading {
            margin-bottom: 1.5rem;
        }
        .trailer-eyebrow {
            font-size: 0.55rem;
            letter-spacing: 0.25em;
        }
        .trailer-heading h2 {
            font-size: 2rem;
        }
        .trailer-wrapper {
            border-radius: 4px;
            box-shadow:
                0 12px 35px rgba(0, 0, 0, 0.4);
        }
    }
</style>