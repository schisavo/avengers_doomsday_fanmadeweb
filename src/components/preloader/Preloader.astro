<div
    id="preloader"
    class="fixed inset-0 z-15 flex items-center justify-center overflow-hidden bg-black"
    aria-hidden="true">
    <!-- Aura central: Dibujo de la explosion alrededor de punto de colision -->
    <div
        class="absolute left-1/2 top-1/2 h-32 w-32 -translate-x-1/2 -translate-y-1/2 rounded-full bg-emerald-500/10 blur-3xl"
        data-incursion-glow>
    </div>
    <!-- Punto de colision: Punto donde se encuentran los planetas se encuentran -->
    <div
        class="absolute left-1/2 top-1/2 h-2 w-2 -translate-x-1/2 -translate-y-1/2 rounded-full bg-emerald-300 opacity-0"
        data-incursion-core>
    </div>
    <!-- Las tres incursiones: Planetas que colisionan (3) -->
    <div
        class="relative h-40 w-40"
        data-incursion-stage>
        <!-- Incursion Avengers -->
        <div
            class="absolute left-1/2 top-1/2 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/40 bg-black/80 shadow-[0_0_30px_rgba(16,185,129,0.7)]"
            data-incursion-ball
        >
            <div
                class="absolute inset-0 rounded-full bg-emerald-500/20 blur-md"
            ></div>

            <img
                src="icons/avengers.svg"
                alt=""
                aria-hidden="true"
                class="relative z-10 h-6 w-6 object-contain"
                draggable="false"
            />
        </div>

        <!-- Incursion X-Men -->
        <div
            class="absolute left-1/2 top-1/2 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/40 bg-black/80 shadow-[0_0_30px_rgba(16,185,129,0.7)]"
            data-incursion-ball
        >
            <div
                class="absolute inset-0 rounded-full bg-emerald-500/20 blur-md"
            ></div>

            <img
                src="icons/xmen.svg"
                alt=""
                aria-hidden="true"
                class="relative z-10 h-6 w-6 object-contain"
                draggable="false"
            />
        </div>

        <!-- Incursion Fantastic Four -->
        <div
            class="absolute left-1/2 top-1/2 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border border-emerald-400/40 bg-black/80 shadow-[0_0_30px_rgba(16,185,129,0.7)]"
            data-incursion-ball
        >
            <div
                class="absolute inset-0 rounded-full bg-emerald-500/20 blur-md"
            ></div>

            <img
                src="icons/fantastic4.svg"
                alt=""
                aria-hidden="true"
                class="relative z-10 h-6 w-6 object-contain"
                draggable="false"
            />
        </div>
    </div>
    <!-- Flash de la colision -->
    <div
        class="pointer-events-none absolute inset-0 bg-emerald-400 opacity-0"
        data-incursion-flash>
    </div>
    <!-- Onda expansiva -->
    <div
        class="pointer-events-none absolute left-1/2 top-1/2 h-4 w-4 -translate-x-1/2 -translate-y-1/2 rounded-full border border-emerald-300 opacity-0"
        data-incursion-wave>
    </div>
</div>