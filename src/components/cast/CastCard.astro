---
import type { CastMember } from "../../data/cast";

interface Props {
  member: CastMember;
}

const { member } = Astro.props;
---

<div
  class="cast-card group flex w-36 shrink-0 cursor-pointer flex-col items-center sm:w-44 md:w-52 lg:w-60"
>
  <article
    class="relative h-56 w-full overflow-hidden rounded-md sm:h-64 md:h-72 lg:h-80"
  >

    <!-- Imagen del actor -->
    <img
      src={member.actorImage}
      alt={member.actorName}
      loading="lazy"
      draggable="false"
      class="actor-img h-full w-full rounded-md object-cover shadow-[0_20px_40px_-20px_rgba(0,0,0,0.5)] transition-transform duration-500 ease-out group-hover:scale-[1.03]"
    />

    <!-- Imagen del personaje -->
    <img
      src={member.characterImage}
      alt={member.characterName}
      loading="lazy"
      draggable="false"
      class="character-img pointer-events-none absolute inset-0 h-full w-full object-contain opacity-0 translate-y-[20%] transition-all duration-500 ease-out group-hover:translate-y-0 group-hover:opacity-100"
    />

    <!-- Equipo / Team -->
    <div
      class="absolute left-2 bottom-1 z-20 flex items-center gap-2 rounded-md px-2.5 py-1 shadow-lg backdrop-blur-sm sm:left-3 sm:bottom-3 sm:px-3 sm:py-1.5"
      style={`background-color: ${member.teamColor};`}
    >
      {
        member.team === "Villain" && (
          <div class="p-2 bg-white rounded-full">
            <img src="/icons/doom.svg" alt="Avengers" class="h-6 w-6 rounded-full" />
          </div>
        )
      }
      {
        member.team === "Avengers" && (
          <div class="p-2 bg-white rounded-full">
            <img src="/icons/avengers.svg" alt="Avengers" class="h-6 w-6 rounded-full" />
          </div>
        )
      }
      {
        member.team === "X-Men" && (
          <div class="p-2 bg-white rounded-full">
            <img src="/icons/xmen.svg" alt="Avengers" class="h-6 w-6 rounded-full" />
          </div>
        )
      }
      {
        member.team === "Fantastic Four" && (
          <div class="p-2 bg-white rounded-full">
            <img src="/icons/fantastic4.svg" alt="Avengers" class="h-6 w-6 rounded-full" />
          </div>
        )
      }

      <span class="text-[0.65rem] font-bold uppercase tracking-wider text-white sm:text-xs">
        {member.team}
      </span>
    </div>


    <!-- Overlay sutil al hacer hover -->
    <div
      class="pointer-events-none absolute inset-0 bg-linear-to-t from-black/30 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    >
    </div>
  </article>

  <!-- Nombre -->
  <p
    class="mt-2 w-full rounded px-2 py-1 text-center text-xs font-semibold text-white transition-all duration-300 sm:text-sm"
    style={`background-color: ${member.teamColor};`}
  >
    <span class="actor-name inline">
      {member.actorName}
    </span>

    <span class="character-name hidden">
      {member.characterName}
    </span>
  </p>
</div>

<style>
  /*
   * En dispositivos con hover real:
   * Actor → Personaje
   */
    @media (hover: hover) {
    .cast-card:hover .actor-name {
      display: none;
    }
    .cast-card:hover .character-name {
      display: inline;
    }
  }

  /* Para dispositivos táctiles: cuando se activa con click */
  .cast-card.active .actor-name {
    display: none;
  }
  .cast-card.active .character-name {
    display: inline;
  }
  .cast-card.active .actor-img {
    transform: scale(1.03);
  }
  .cast-card.active .character-img {
    opacity: 1;
    transform: translateY(0);
  }
  .cast-card.active .pointer-events-none {
    opacity: 1;
  }

</style>