---
import { movie } from "../../../data/movie";

import Countdown from "../../ui/Countdown/Countdown.astro";
import ProjectCard from "./ProjectCard.astro";

const { release } = movie;
---

<section
    id="pre-footer"
    class="relative isolate min-h-screen w-full overflow-hidden bg-doom-black text-doom-white"
>
    <!-- Fondo atmosferico del prefooter -->
    <div
        class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_50%_45%,var(--color-doom-green-glow),transparent_35%),radial-gradient(circle_at_50%_100%,var(--color-doom-green-energy),transparent_45%),var(--color-doom-black)]"
        aria-hidden="true"
    ></div>

    <!-- Textura de ruido -->
    <div
        class="prefooter-noise pointer-events-none absolute inset-0 opacity-[0.035]"
        aria-hidden="true"
    ></div>

    <!-- Contenido principal -->
    <div
        class="relative z-10 flex min-h-screen flex-col items-center justify-center px-6 py-24 text-center"
    >
        <!-- Identificador de la fecha de lanzamiento -->
        <p
            id="prefooter-eyebrow"
            class="mb-5 text-[10px] font-semibold uppercase tracking-[0.45em] text-doom-green sm:text-xs"
        >
            {release.eyebrow}
        </p>

        <!-- Fecha de lanzamiento -->
        <h2
            id="prefooter-date"
            class="font-serif text-5xl leading-none tracking-tight sm:text-7xl md:text-8xl"
        >
            {release.displayDate.day}

            <span class="block text-doom-green">
                {release.displayDate.year}
            </span>
        </h2>

        <!-- Descripcion de la fecha -->
        <p
            id="prefooter-subtitle"
            class="mt-6 max-w-xl text-sm leading-relaxed text-doom-white-half sm:text-base"
        >
            {release.subtitle}
        </p>

        <!-- Contador de lanzamiento -->
        <div
            id="prefooter-countdown"
            class="mt-12"
        >
            <Countdown
                id="release-countdown"
                targetDate={release.date}
            />
        </div>

        <!-- Informacion sobre el proyecto -->
        <ProjectCard />
    </div>
</section>

<script>
    import { initializeRelease } from "../../../lib/animations/release";

    initializeRelease();
</script>