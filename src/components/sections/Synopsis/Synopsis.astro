---
import SynopsisImage from './SynopsisImage.astro';
import SynopsisTitle from './SynopsisTitle.astro';
import SynopsisText from './SynopsisText.astro';
import SynopsisCredits from './SynopsisCredits.astro';
---

<section
    id="synopsis"
    class="w-full py-12 sm:py-16"
>
    <div
        class="mx-auto grid max-w-275 items-center gap-10 px-4 sm:px-6 md:grid-cols-[minmax(240px,0.8fr)_minmax(280px,1.2fr)] md:gap-10 lg:grid-cols-[minmax(280px,0.9fr)_minmax(320px,1.1fr)] lg:gap-[clamp(2rem,5vw,6rem)]"
    >
        <!-- Synopsis artwork -->
        <SynopsisImage />

        <!-- Synopsis information -->
        <div class="flex flex-col gap-8 md:gap-10">
            <SynopsisTitle />

            <SynopsisText />

            <SynopsisCredits />
        </div>
    </div>
</section>