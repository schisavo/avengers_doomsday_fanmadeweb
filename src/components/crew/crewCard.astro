---
import type { CrewMember } from "../../data/crew";

interface Props {
  member: CrewMember;
}

const { member } = Astro.props;
---

<div
  class="crew-card group flex w-[9rem] shrink-0 cursor-pointer flex-col items-center sm:w-[11rem] md:w-[13rem] lg:w-[15rem]"
>
  <article
    class="relative h-[14rem] w-full overflow-hidden rounded-md bg-white/5 sm:h-[16rem] md:h-[18rem] lg:h-[20rem]"
  >
    <!-- ================================= -->
    <!-- FOTO DE LA PERSONA -->
    <!-- ================================= -->

    <img
      src={member.image}
      alt={member.name}
      loading="lazy"
      draggable="false"
      class="person-img h-full w-full rounded-md object-cover shadow-[0_20px_40px_-20px_rgba(0,0,0,0.5)] transition-all duration-500 ease-out group-hover:scale-[1.03] group-hover:opacity-40"
    />

    <!-- ================================= -->
    <!-- PORTADA DEL TRABAJO -->
    <!-- ================================= -->

    <div
      class="work-poster pointer-events-none absolute inset-0 flex translate-y-[25%] items-end justify-center opacity-0 transition-all duration-500 ease-out group-hover:translate-y-0 group-hover:opacity-100"
    >
      <img
        src={member.work.image}
        alt={member.work.title}
        loading="lazy"
        draggable="false"
        class="h-full w-full object-cover"
      />
    </div>

    <!-- ================================= -->
    <!-- OVERLAY -->
    <!-- ================================= -->

    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"
    >
    </div>

    <!-- ================================= -->
    <!-- MARVEL -->
    <!-- ================================= -->

    {
      member.work.marvel && (
        <span
          class="absolute right-2 top-2 z-20 rounded-md border border-white/20 bg-black/50 px-2 py-1 text-[0.55rem] font-bold uppercase tracking-[0.15em] text-white shadow-lg backdrop-blur-md sm:right-3 sm:top-3"
        >
          Marvel
        </span>
      )
    }

    <!-- ================================= -->
    <!-- INFORMACIÓN DEL TRABAJO -->
    <!-- ================================= -->

    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 z-20 translate-y-3 px-3 pb-3 opacity-0 transition-all duration-500 ease-out group-hover:translate-y-0 group-hover:opacity-100 sm:px-4 sm:pb-4"
    >
      <p
        class="text-[0.6rem] font-semibold uppercase tracking-[0.18em] text-white/50"
      >
        Trabajo destacado
      </p>

      <h3
        class="mt-1 line-clamp-2 text-sm font-bold leading-tight text-white sm:text-base"
      >
        {member.work.title}
      </h3>

      <p class="mt-1 text-[0.65rem] text-white/60 sm:text-xs">
        {member.work.year}
        ·
        {member.work.type === "movie"
          ? "Película"
          : "Serie"}
      </p>
    </div>

    <!-- ================================= -->
    <!-- BORDE / GLOW SUTIL -->
    <!-- ================================= -->

    <div
      class="pointer-events-none absolute inset-0 rounded-md border border-white/0 transition-colors duration-500 group-hover:border-[#05a85c]/40"
    >
    </div>
  </article>

  <!-- ================================= -->
  <!-- NOMBRE -->
  <!-- ================================= -->

  <div class="mt-2 w-full text-center">
    <p
      class="person-name text-xs font-semibold text-white transition-all duration-300 sm:text-sm"
    >
      {member.name}
    </p>

    <p
      class="mt-0.5 text-[0.65rem] font-medium uppercase tracking-wider text-white/40 transition-all duration-300 sm:text-xs"
    >
      {member.role}
    </p>

    <!-- Nombre del trabajo en mobile -->
    <p
      class="work-name mt-1 line-clamp-1 text-[0.65rem] font-medium text-white/50 sm:hidden"
    >
      {member.work.title}
    </p>
  </div>
</div>

<style>
  /*
   * En dispositivos con hover real,
   * el contenido de la portada aparece
   * únicamente al interactuar.
   */

  @media (hover: hover) {
    .crew-card:hover .person-name {
      color: rgba(255, 255, 255, 0.6);
    }
  }

  /*
   * En dispositivos táctiles no dependemos
   * del hover para mostrar el trabajo.
   * El nombre del trabajo queda visible debajo.
   */

  @media (hover: none) {
    .work-poster {
      display: none;
    }
  }
</style>

