---
/* Layout principal */
import BaseLayout from "../layouts/BaseLayout.astro";
/* Pantalla de carga inicial */
import Preloader from "../components/preloader/Preloader.astro";
/* Secciones principales */
import Hero from "../components/sections/Hero/Hero.astro";
import Trailer from "../components/sections/Trailer/Trailer.astro";
import Synopsis from "../components/sections/Synopsis/Synopsis.astro";
import Cast from "../components/sections/Cast/Cast.astro";
import Crew from "../components/sections/Crew/Crew.astro";
import Gallery from "../components/sections/Gallery/Gallery.astro";
import Release from "../components/sections/Release/Release.astro";
/* Navegacion global */
import CornerMenu from "../components/ui/CornerMenu/CornerMenu.astro";
---

<BaseLayout
	title="Avengers: Doomsday — Fan Page"
	description="Fan-made website dedicated to Avengers: Doomsday."
>
	<!-- Pantalla de carga -->
	<Preloader />

	<!-- Contenido principal -->
	<main>
		<!-- Menu de navegacion -->
		<CornerMenu />

		<!-- Secciones de la pagina -->
		<Hero />
		<Trailer />
		<Synopsis />
		<Cast />
		<Crew />
		<Gallery />
		<Release />
	</main>
</BaseLayout>