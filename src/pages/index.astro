---
import '../styles/global.css'
import Preloader from '../components/preloader/Preloader.astro'
import Hero from '../components/hero/Hero.astro'
import MovieInfo from '../components/movie/MovieInfo.astro'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="" />
		<link rel="icon" href="/icons/doom.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro</title>
	</head>
	<body>
		<Preloader />
		
		<!-- Hero - Presentation Section: Paralax effect, words effect, frame effect -->
        <section id="hero" class="scroll-mt-24">
            <Hero />
        </section>
		<!-- Movie info: trailer, sypnosis, cast, crew,  -->
		<MovieInfo />
	</body>
</html>
