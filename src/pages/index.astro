---
import '../styles/global.css'
import Preloader from '../components/preloader/Preloader.astro'
import Hero from '../components/hero/Hero.astro'
import MovieInfo from '../components/movie/MovieInfo.astro'
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
    	<link rel="icon" href="/favicon.ico" sizes="48x48 32x32 16x16" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>FanPage - Avengers Doomsday</title>
	</head>
	<body>
		<Preloader />
		
		<!-- Hero - Presentation Section: Paralax effect, words effect, frame effect -->
        <section id="hero" class="scroll-mt-24">
            <Hero />
        </section>
		<!-- Movie info: trailer, sypnosis, cast, crew,  -->
		<MovieInfo />



		<script>
			import "../lib/main.ts";
		</script>
	</body>
</html>
